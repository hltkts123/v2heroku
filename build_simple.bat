@echo off
chcp 65001 >nul
echo ????????????????????????????????????????????????????????????????
echo ?     BUILD PowerPoint Cleaner - SIMPLE VERSION                ?
echo ????????????????????????????????????????????????????????????????
echo.

echo [1/3] Installing dependencies...
pip install python-pptx pillow pyinstaller
if errorlevel 1 (
    echo ? Failed to install dependencies
    pause
    exit /b 1
)
echo ? Dependencies installed

echo.
echo [2/3] Cleaning old builds...
if exist build rd /s /q build
if exist dist rd /s /q dist
del *.spec 2>nul
echo ? Cleaned

echo.
echo [3/3] Building EXE files (without icon)...
echo.

echo Building single file version...
pyinstaller ^
    --noconfirm ^
    --clean ^
    --name "PowerPointCleaner" ^
    --onefile ^
    --windowed ^
    --hidden-import=pptx ^
    --hidden-import=pptx.util ^
    --hidden-import=PIL ^
    ppt_cleaner.py

echo.
echo Building batch version...
pyinstaller ^
    --noconfirm ^
    --clean ^
    --name "PowerPointCleanerBatch" ^
    --onefile ^
    --windowed ^
    --hidden-import=pptx ^
    --hidden-import=pptx.util ^
    --hidden-import=PIL ^
    ppt_cleaner_batch.py

echo.
echo ????????????????????????????????????????????????????????????????
echo ?                    BUILD COMPLETED                           ?
echo ????????????????????????????????????????????????????????????????
echo.
echo EXE files in 'dist' folder:
dir dist\*.exe
echo.
echo Note: Built without custom icon (safer)
echo.
pause
