@echo off
chcp 65001 >nul
echo ????????????????????????????????????????????????????????????????
echo ?     FIX AND BUILD - PowerPoint Cleaner to EXE                ?
echo ????????????????????????????????????????????????????????????????
echo.

echo [1/5] Checking Python...
python --version >nul 2>&1
if errorlevel 1 (
    echo ? Python not found! Please install Python 3.6+ first
    echo    Download: https://www.python.org/downloads/
    pause
    exit /b 1
)
python --version
echo ? Python found

echo.
echo [2/5] Upgrading pip...
python -m pip install --upgrade pip
echo ? pip upgraded

echo.
echo [3/5] Installing dependencies (this may take a few minutes)...
python -m pip install python-pptx pillow pyinstaller
if errorlevel 1 (
    echo ? Failed to install dependencies
    echo.
    echo Try running Command Prompt as Administrator
    pause
    exit /b 1
)
echo ? Dependencies installed

echo.
echo [4/5] Verifying PyInstaller...
python -m PyInstaller --version
if errorlevel 1 (
    echo ? PyInstaller not working properly
    pause
    exit /b 1
)
echo ? PyInstaller ready

echo.
echo [5/5] Building EXE files...
echo.

REM Clean old builds
if exist build rd /s /q build
if exist dist rd /s /q dist
del *.spec 2>nul

echo Building PowerPointCleaner.exe...
python -m PyInstaller ^
    --noconfirm ^
    --clean ^
    --name "PowerPointCleaner" ^
    --onefile ^
    --windowed ^
    --hidden-import=pptx ^
    --hidden-import=pptx.util ^
    --hidden-import=PIL.Image ^
    ppt_cleaner.py

if errorlevel 1 (
    echo ? Build failed for PowerPointCleaner
    pause
    exit /b 1
)

echo.
echo Building PowerPointCleanerBatch.exe...
python -m PyInstaller ^
    --noconfirm ^
    --clean ^
    --name "PowerPointCleanerBatch" ^
    --onefile ^
    --windowed ^
    --hidden-import=pptx ^
    --hidden-import=pptx.util ^
    --hidden-import=PIL.Image ^
    ppt_cleaner_batch.py

if errorlevel 1 (
    echo ? Build failed for PowerPointCleanerBatch
    pause
    exit /b 1
)

echo.
echo ????????????????????????????????????????????????????????????????
echo ?                    BUILD SUCCESS!                            ?
echo ????????????????????????????????????????????????????????????????
echo.
echo EXE files created in 'dist' folder:
dir /b dist\*.exe
echo.
echo File sizes:
dir dist\*.exe
echo.
echo You can now distribute these EXE files!
echo.
pause
