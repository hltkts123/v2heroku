@echo off
chcp 65001 >nul
echo ????????????????????????????????????????????????????????????????
echo ?          BUILD PowerPoint Cleaner to EXE                     ?
echo ????????????????????????????????????????????????????????????????
echo.

echo [1/4] Checking Python...
python --version >nul 2>&1
if errorlevel 1 (
    echo ? Python not found! Please install Python 3.6+
    pause
    exit /b 1
)
echo ? Python found

echo.
echo [2/4] Installing PyInstaller...
pip install pyinstaller pillow >nul 2>&1
if errorlevel 1 (
    echo ? Failed to install PyInstaller
    pause
    exit /b 1
)
echo ? PyInstaller installed

echo.
echo [3/4] Creating icon...
python create_icon.py
if errorlevel 1 (
    echo ! Warning: Failed to create icon, using default
)

echo.
echo [4/4] Building EXE files...
echo.
echo Building single file version...
pyinstaller --noconfirm --clean ^
    --name "PowerPointCleaner" ^
    --onefile ^
    --windowed ^
    --icon="icon.ico" ^
    --add-data "icon.ico;." ^
    ppt_cleaner.py

echo.
echo Building batch version...
pyinstaller --noconfirm --clean ^
    --name "PowerPointCleanerBatch" ^
    --onefile ^
    --windowed ^
    --icon="icon.ico" ^
    --add-data "icon.ico;." ^
    ppt_cleaner_batch.py

echo.
echo ????????????????????????????????????????????????????????????????
echo ?                    BUILD COMPLETED                           ?
echo ????????????????????????????????????????????????????????????????
echo.
echo EXE files created in 'dist' folder:
echo   - PowerPointCleaner.exe (single file mode)
echo   - PowerPointCleanerBatch.exe (batch mode)
echo.
echo You can distribute these EXE files without Python!
echo.
pause
