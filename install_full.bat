@echo off
chcp 65001 >nul
echo ????????????????????????????????????????????????????????????????
echo ?     CAI DAT TAT CA DEPENDENCIES - Full Package               ?
echo ????????????????????????????????????????????????????????????????
echo.

echo [1/2] Checking Python...
python --version
if errorlevel 1 (
    echo ? Python not found! Please install Python 3.6+
    echo    Download: https://www.python.org/downloads/
    pause
    exit /b 1
)
echo ? Python found

echo.
echo [2/2] Installing all dependencies...
echo This may take a few minutes...
echo.

python -m pip install --upgrade pip
python -m pip install -r requirements_full.txt

if errorlevel 1 (
    echo.
    echo ? Installation failed!
    echo.
    echo Try running as Administrator
    pause
    exit /b 1
)

echo.
echo ????????????????????????????????????????????????????????????????
echo ?              INSTALLATION COMPLETED                          ?
echo ????????????????????????????????????????????????????????????????
echo.
echo Installed packages:
python -m pip list | findstr "python-pptx requests beautifulsoup4"
echo.
echo You can now run:
echo   - run_launcher.bat     (Launcher - chon tool)
echo   - run.bat              (PowerPoint Cleaner Single)
echo   - run_batch.bat        (PowerPoint Cleaner Batch)
echo.
pause
